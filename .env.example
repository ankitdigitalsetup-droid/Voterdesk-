# ===================================================================
# VoterDesk Production & Development Environment Configuration
# ===================================================================

# 1. DATABASE CONFIGURATION (Neon / Supabase / AWS PostgreSQL)
# Pooled connection string for serverless API queries (pgBouncer / neon-pooler)
DATABASE_URL="postgresql://neondb_owner:password@ep-flat-hat-zauqkaul-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string for Prisma migrations & schema push
DIRECT_URL="postgresql://neondb_owner:password@ep-flat-hat-zauqkaul.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Note for Local Windows development (if IPv6 DNS resolution issues occur):
# DATABASE_URL="postgresql://neondb_owner:password@<ipv4-address>/neondb?sslmode=require&options=endpoint%3Dep-flat-hat-zauqkaul-pooler"

# 2. AUTHENTICATION & SECURITY
# Strong secret used to sign session cookies and JWT auth tokens (min 32 chars)
SESSION_SECRET="voterdesk-super-secure-session-key-change-in-production-2026"

# 3. PUBLIC APP CONFIGURATION
# Full URL where the app is hosted (used for voter slip WhatsApp links, QR codes, redirect URLs)
# Local: http://localhost:3000
# Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="VoterDesk"
